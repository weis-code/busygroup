# ─────────────────────────────────────────────────────────────────────────────
# NextLevelGroup Agent Dashboard — Environment Variables
# Kopiér denne fil til .env.local til lokal udvikling
# På Railway sættes disse under Settings → Variables
# ─────────────────────────────────────────────────────────────────────────────

# PÅKRÆVET — JWT session-kryptering (min. 32 tegn, helst random)
JWT_SECRET=skift-dette-til-noget-hemmeligt-minimum-32-tegn

# Sti til SQLite-database
# Lokalt: lad stå tom (bruger ./nextlevelgroup.db i projektmappen)
# Railway: /data/nextlevelgroup.db (persistent volumen monteret på /data)
DATABASE_PATH=/data/nextlevelgroup.db

# Standard login-passwords (bruges kun ved første opstart til at seede databasen)
# Skift dem straks via Indstillinger → Brugere efter første login
ADMIN_PASSWORD=VælgEtStærktAdminPassword!
SELLER_PASSWORD=VælgEtStærktSælgerPassword!

# ─────────────────────────────────────────────────────────────────────────────
# AI & Integrationer
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude — bruges af alle agenter
ANTHROPIC_API_KEY=sk-ant-...

# Slack — bruges af CSO-agent og kritiske fejl
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Resend — bruges til email-outreach fra agenter
# Opret på resend.com (gratis op til 3.000 mails/måned)
RESEND_API_KEY=re_...
EMAIL_FROM=NextLevelGroup <salg@busyconsulting.dk>

# Valgfrit
PHANTOMBUSTER_API_KEY=
